+    def _apply_multiframe_radar_weighting(self, radar_data):
+        num_frames = self._parse_multiframe_count(self.radar_folder)
+        if num_frames is None or num_frames <= 1 or radar_data.shape[1] <= 6:
+            return radar_data
+
+        radar_data = radar_data.copy()
+        time_vals = radar_data[:, 6]
+        time_weights = np.ones_like(time_vals, dtype=np.float32)
+        normalized_time = np.ones_like(time_vals, dtype=np.float32)
+
+        max_history = max(0, num_frames - 1)
+        for history_idx in range(1, max_history + 1):
+            history_mask = time_vals == -float(history_idx)
+            if not np.any(history_mask):
+                continue
+            time_weights[history_mask] = max(0.1, 1.0 - 0.1 * history_idx)
+            normalized_time[history_mask] = max(
+                0.0,
+                1.0 - history_idx / max(max_history, 1),
+            )
+
+        # Preserve both raw and compensated radial velocity while softly
+        # downweighting older frames.
+        radar_data[:, 3] *= time_weights  # RCS
+        radar_data[:, 4] *= time_weights  # v_r
+        radar_data[:, 5] *= time_weights  # v_r_compensated
+        radar_data[:, 6] = normalized_time
+        return radar_data
+
