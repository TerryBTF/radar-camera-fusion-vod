+def _load_pretrained_student_weights(model, checkpoint_path):
+    checkpoint = torch.load(checkpoint_path, map_location='cpu', weights_only=False)
+    state_dict = checkpoint.get('state_dict', checkpoint)
+    missing_keys, unexpected_keys = model.load_state_dict(state_dict, strict=False)
+
+    ignored_missing = {
+        key for key in missing_keys
+        if key.startswith('_teacher_model.')
+    }
+    remaining_missing = [key for key in missing_keys if key not in ignored_missing]
+
+    if remaining_missing or unexpected_keys:
+        raise RuntimeError(
+            'Warm-start student checkpoint is not compatible with current model. '
+            f'Missing keys: {remaining_missing}. Unexpected keys: {unexpected_keys}.'
+        )
+
