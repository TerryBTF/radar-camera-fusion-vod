+
+        roi_x_min, roi_x_max = float(roi_x_range[0]), float(roi_x_range[1])
+        roi_y_min, roi_y_max = float(roi_y_range[0]), float(roi_y_range[1])
+
+        x_centers = torch.linspace(
+            x_min + (x_max - x_min) / (2 * width),
+            x_max - (x_max - x_min) / (2 * width),
+            width,
+            device=device,
+        )
+        y_centers = torch.linspace(
+            y_min + (y_max - y_min) / (2 * height),
+            y_max - (y_max - y_min) / (2 * height),
+            height,
+            device=device,
