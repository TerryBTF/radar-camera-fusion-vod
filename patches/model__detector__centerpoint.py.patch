+    def _extract_image_features(self, images):
+        batch_images = torch.stack(images, dim=0).to(self.device)
+        if not torch.is_floating_point(batch_images):
+            batch_images = batch_images.float().div(255.0)
+        elif batch_images.max() > 1.0:
+            batch_images = batch_images / 255.0
+        batch_images = (batch_images - self.image_mean) / self.image_std
+        return self.image_backbone(batch_images)
+
+    def _sample_point_image_features(
+        self,
+        points,
+        feature_map,
+        image_shape,
+        points_to_cam,
+        camera_proj,
+    ):
+        if points.numel() == 0:
+            return feature_map.new_zeros((0, feature_map.shape[0]))
+
+        points = points.to(self.device)
+        points_to_cam = points_to_cam.to(self.device)
+        camera_proj = camera_proj.to(self.device)
+        num_points = points.shape[0]
+
+        points_homo = torch.cat(
+            [
+                points[:, :3],
+                torch.ones((num_points, 1), device=self.device, dtype=points.dtype),
+            ],
+            dim=1,
+        )
+        points_camera = points_homo @ points_to_cam.T
+        projected = points_camera @ camera_proj.T
+
+        depth = projected[:, 2]
+        safe_depth = torch.where(
+            depth.abs() < 1e-6,
+            torch.full_like(depth, 1e-6),
+            depth,
+        )
+        uv = projected[:, :2] / safe_depth.unsqueeze(1)
+
+        image_h, image_w = image_shape
+        valid_mask = (
+            (depth > 0)
+            & (uv[:, 0] >= 0)
+            & (uv[:, 0] <= image_w - 1)
+            & (uv[:, 1] >= 0)
+            & (uv[:, 1] <= image_h - 1)
+        )
+
+        x_norm = (uv[:, 0] / max(image_w - 1, 1)) * 2 - 1
+        y_norm = (uv[:, 1] / max(image_h - 1, 1)) * 2 - 1
+        grid = torch.stack([x_norm, y_norm], dim=-1).view(1, num_points, 1, 2)
+
+        sampled = F.grid_sample(
+            feature_map.unsqueeze(0),
+            grid,
+            mode='bilinear',
+            padding_mode='zeros',
+            align_corners=True,
+        )
+        sampled = sampled.squeeze(0).squeeze(-1).transpose(0, 1)
+        sampled[~valid_mask] = 0
+
+        return sampled
+
+    def _sample_batch_point_image_features(
+        self,
+        pts_data,
+        images,
+        points_to_cams,
+        camera_projs,
+    ):
+        if not self.use_image_features:
+            return None
+
+        image_features = self._extract_image_features(images)
+        sampled_point_features = []
+        multi_scale = isinstance(image_features, (tuple, list))
+        for sample_idx, (points, image, points_to_cam, camera_proj) in enumerate(
+            zip(pts_data, images, points_to_cams, camera_projs)
+        ):
+            if multi_scale:
+                sampled_parts = []
+                for feature_map in image_features:
+                    sampled_parts.append(
+                        self._sample_point_image_features(
+                            points=points,
+                            feature_map=feature_map[sample_idx],
+                            image_shape=image.shape[-2:],
+                            points_to_cam=points_to_cam,
+                            camera_proj=camera_proj,
+                        )
+                    )
+                sampled_image = torch.cat(sampled_parts, dim=-1)
+            else:
+                sampled_image = self._sample_point_image_features(
+                    points=points,
+                    feature_map=image_features[sample_idx],
+                    image_shape=image.shape[-2:],
+                    points_to_cam=points_to_cam,
+                    camera_proj=camera_proj,
+                )
+            sampled_point_features.append(sampled_image)
+
+        return sampled_point_features
+
+    def _align_dynamic_to_hard_voxels(self, dynamic_features, dynamic_coors, hard_coors):
+        if hard_coors.shape[0] == 0:
+            return dynamic_features.new_zeros((0, dynamic_features.shape[1]))
+
+        dynamic_coors_cpu = dynamic_coors.detach().cpu().tolist()
+        hard_coors_cpu = hard_coors.detach().cpu().tolist()
+        dynamic_index = {tuple(coor): idx for idx, coor in enumerate(dynamic_coors_cpu)}
+
+        aligned = dynamic_features.new_zeros((hard_coors.shape[0], dynamic_features.shape[1]))
+        matched_indices = []
+        matched_rows = []
+        for row_idx, coor in enumerate(hard_coors_cpu):
+            feature_idx = dynamic_index.get(tuple(coor))
+            if feature_idx is not None:
+                matched_rows.append(row_idx)
+                matched_indices.append(feature_idx)
+
+        if matched_indices:
+            matched_rows = torch.tensor(matched_rows, device=aligned.device, dtype=torch.long)
+            matched_indices = torch.tensor(matched_indices, device=aligned.device, dtype=torch.long)
+            aligned[matched_rows] = dynamic_features[matched_indices]
+
+        return aligned
+
+    def _aggregate_image_features_to_pillars(self, pts_data, sampled_point_features, hard_coors):
+        if not self.use_image_features:
+            return None
+
+        batch_pillar_features = []
+        for batch_idx, (points, point_image_features) in enumerate(zip(pts_data, sampled_point_features)):
+            sample_hard_mask = hard_coors[:, 0] == batch_idx
+            sample_hard_coors = hard_coors[sample_hard_mask][:, 1:]
+
+            if sample_hard_coors.shape[0] == 0:
+                batch_pillar_features.append(
+                    point_image_features.new_zeros((0, point_image_features.shape[1]))
+                )
+                continue
+
+            sample_dynamic_coors = voxelization(
+                points.to(self.device),
+                self.voxel_layer.voxel_size,
+                self.voxel_layer.point_cloud_range,
+                -1,
+                -1,
+                self.voxel_layer.deterministic,
+            )
+            dynamic_features, dynamic_coors = self.image_scatter(
+                point_image_features,
+                sample_dynamic_coors,
+            )
+            aligned_features = self._align_dynamic_to_hard_voxels(
+                dynamic_features=dynamic_features,
+                dynamic_coors=dynamic_coors,
+                hard_coors=sample_hard_coors,
+            )
+            batch_pillar_features.append(aligned_features)
+
+        return torch.cat(batch_pillar_features, dim=0)
+
+    def _apply_temporal_encoding_to_voxels(self, voxels, num_points):
+        if self.temporal_encoder is None or voxels.numel() == 0:
+            return voxels
+
+        encoded_voxels = voxels.clone()
+        max_points = encoded_voxels.shape[1]
+        point_ids = torch.arange(max_points, device=encoded_voxels.device).unsqueeze(0)
+        valid_mask = point_ids < num_points.unsqueeze(1)
+        flat_valid = valid_mask.reshape(-1)
+        if not flat_valid.any():
+            return encoded_voxels
+
+        flat_voxels = encoded_voxels.reshape(-1, encoded_voxels.shape[-1])
+        flat_voxels[flat_valid] = self.temporal_encoder(flat_voxels[flat_valid])
+        return flat_voxels.view_as(encoded_voxels)
+
+    def _fuse_pillar_features(self, radar_pillar_features, image_pillar_features):
+        pillar_context = self._build_pillar_fusion_context(
+            self.latest_pillar_coors,
+            self.latest_pillar_num_points,
