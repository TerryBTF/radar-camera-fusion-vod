+        return cpu_results
+
+    def _update_gate_stats(self, gt_bboxes_3d, gt_labels_3d):
+        if not self.use_image_features or self.latest_pillar_gate_strengths is None:
+            return
+
+        vx = self.voxel_layer.voxel_size[0]
+        vy = self.voxel_layer.voxel_size[1]
+        vz = self.voxel_layer.voxel_size[2]
+        x_min, y_min, z_min = self.voxel_layer.point_cloud_range[:3]
+        device = self.device
+
+        for batch_idx, (boxes_3d, labels_3d) in enumerate(zip(
+            gt_bboxes_3d,
+            gt_labels_3d,
+        )):
+            sample_mask = self.latest_pillar_coors[:, 0] == batch_idx
+            sample_coors = self.latest_pillar_coors[sample_mask]
+            gate_strengths = self.latest_pillar_gate_strengths[sample_mask].detach().cpu()
+            if gate_strengths.numel() == 0:
+                continue
+
+            self.gate_stats['global_sum'] += gate_strengths.sum().item()
+            self.gate_stats['global_sq_sum'] += gate_strengths.square().sum().item()
+            self.gate_stats['global_count'] += int(gate_strengths.numel())
+            self.gate_stats['global_low_count'] += int((gate_strengths < 0.1).sum().item())
+            self.gate_stats['global_high_count'] += int((gate_strengths > 0.9).sum().item())
+
+            pillar_centers = torch.stack(
+                [
+                    sample_coors[:, 3].float() * vx + x_min + vx / 2,
+                    sample_coors[:, 2].float() * vy + y_min + vy / 2,
+                    sample_coors[:, 1].float() * vz + z_min + vz / 2,
+                ],
+                dim=1,
+            )
+            points_xyz = pillar_centers.unsqueeze(0).to(device)
+            boxes_tensor = boxes_3d.tensor[:, :7].unsqueeze(0).to(self.device)
+            point_box_indices = points_in_boxes_gpu(points_xyz, boxes_tensor).squeeze(0).detach().cpu()
+            labels_cpu = labels_3d.detach().cpu()
+            box_centers = boxes_3d.gravity_center.detach().cpu()
+
+            assigned_mask = point_box_indices >= 0
+            if not assigned_mask.any():
+                continue
+
+            assigned_box_indices = point_box_indices[assigned_mask].long()
+            assigned_gate_strengths = gate_strengths[assigned_mask]
+
+            for class_idx, class_name in enumerate(self.class_names):
+                class_mask = labels_cpu[assigned_box_indices] == class_idx
+                if class_mask.any():
+                    class_gate = assigned_gate_strengths[class_mask]
+                    self.gate_stats['class_sum'][class_name] += class_gate.sum().item()
+                    self.gate_stats['class_count'][class_name] += int(class_gate.numel())
+
+            distances = torch.norm(box_centers[assigned_box_indices][:, :2], dim=1)
+            near_mask = distances < self.gate_distance_bins[0]
+            mid_mask = (distances >= self.gate_distance_bins[0]) & (distances < self.gate_distance_bins[1])
+            far_mask = distances >= self.gate_distance_bins[1]
+
+            for bucket_name, bucket_mask in (
+                ('near', near_mask),
+                ('mid', mid_mask),
+                ('far', far_mask),
+            ):
+                if bucket_mask.any():
+                    bucket_gate = assigned_gate_strengths[bucket_mask]
+                    self.gate_stats['distance_sum'][bucket_name] += bucket_gate.sum().item()
+                    self.gate_stats['distance_count'][bucket_name] += int(bucket_gate.numel())
+
+    def _log_gate_stats(self):
+        total_count = self.gate_stats['global_count']
+        if total_count == 0:
+            return
+
+        mean = self.gate_stats['global_sum'] / total_count
+        variance = max(self.gate_stats['global_sq_sum'] / total_count - mean * mean, 0.0)
+        std = variance ** 0.5
+        low_ratio = self.gate_stats['global_low_count'] / total_count
+        high_ratio = self.gate_stats['global_high_count'] / total_count
+
+        self.log('validation/gate/global_mean', mean, batch_size=1, sync_dist=True)
+        self.log('validation/gate/global_std', std, batch_size=1, sync_dist=True)
+        self.log('validation/gate/low_ratio', low_ratio, batch_size=1, sync_dist=True)
+        self.log('validation/gate/high_ratio', high_ratio, batch_size=1, sync_dist=True)
+
+        for class_name in self.class_names:
+            count = self.gate_stats['class_count'][class_name]
+            if count > 0:
+                value = self.gate_stats['class_sum'][class_name] / count
+                self.log(
+                    f'validation/gate/class_{class_name.lower()}_mean',
+                    value,
+                    batch_size=1,
+                    sync_dist=True,
+                )
+
+        for bucket_name in ('near', 'mid', 'far'):
+            count = self.gate_stats['distance_count'][bucket_name]
+            if count > 0:
+                value = self.gate_stats['distance_sum'][bucket_name] / count
+                self.log(
+                    f'validation/gate/distance_{bucket_name}_mean',
+                    value,
+                    batch_size=1,
+                    sync_dist=True,
+                )
+
+    def _subsample_points(self, points, max_points, feature_index=None):
+        if points.shape[0] <= max_points:
+            return points
+        if feature_index is not None and points.shape[1] > feature_index:
+            scores = points[:, feature_index]
+            keep_idx = torch.topk(scores, k=max_points, largest=True, sorted=False).indices
+            return points[keep_idx]
+        perm = torch.randperm(points.shape[0], device=points.device)[:max_points]
+        return points[perm]
+
+    def _pad_radar_crop(self, points, max_points, feature_dim):
+        padded = points.new_zeros((max_points, feature_dim))
+        mask = torch.zeros((max_points,), dtype=torch.bool, device=points.device)
+        if points.numel() == 0:
+            return padded, mask
+        num = min(points.shape[0], max_points)
+        padded[:num] = points[:num]
+        mask[:num] = True
+        return padded, mask
+
+    def _rotate_points_along_z(self, points_xyz, yaw):
+        cos_yaw = torch.cos(yaw)
+        sin_yaw = torch.sin(yaw)
+        x = points_xyz[:, 0]
+        y = points_xyz[:, 1]
+        rotated_x = cos_yaw * x - sin_yaw * y
+        rotated_y = sin_yaw * x + cos_yaw * y
+        return torch.stack((rotated_x, rotated_y, points_xyz[:, 2]), dim=-1)
+
+    def _to_box_local_points(self, points, box_center, box_dims, box_yaw, normalize=True):
+        local_points = points.clone()
+        local_xyz = local_points[:, :3] - box_center.unsqueeze(0)
+        local_xyz = self._rotate_points_along_z(local_xyz, -box_yaw)
+        if normalize:
+            half_dims = (box_dims * 0.5).clamp_min(1e-2)
+            local_xyz = local_xyz / half_dims.unsqueeze(0)
+        local_points[:, :3] = local_xyz
+        return local_points
+
+    def _from_box_local_xyz(self, local_xyz, box_center, box_dims, box_yaw, normalize=True):
+        global_xyz = local_xyz
+        if normalize:
+            half_dims = (box_dims * 0.5).clamp_min(1e-2)
+            global_xyz = global_xyz * half_dims.unsqueeze(0)
+        global_xyz = self._rotate_points_along_z(global_xyz, box_yaw)
+        global_xyz = global_xyz + box_center.unsqueeze(0)
+        return global_xyz
+
+    def _get_object_densifier_schedule(self):
+        warmup_epochs = int(self.object_densifier_config.get('warmup_epochs', 0))
+        append_after_warmup = bool(self.object_densifier_config.get('append_after_warmup', False))
+        if warmup_epochs <= 0:
+            return 1.0, True
+        progress = min(float(self.current_epoch + 1) / float(warmup_epochs), 1.0)
+        allow_append = (not append_after_warmup) or progress >= 1.0
+        return progress, allow_append
+
+    def _build_virtual_point_features(self, virtual_xyz, radar_crop):
+        feature_dim = radar_crop.shape[1]
+        virtual_points = virtual_xyz.new_zeros((virtual_xyz.shape[0], feature_dim))
+        virtual_points[:, :3] = virtual_xyz
+        if feature_dim > 3:
+            extra_mode = self.object_densifier_config.get('append_feature_mode', 'mean')
+            if radar_crop.shape[0] > 0 and extra_mode == 'mean':
+                extra = radar_crop[:, 3:].mean(dim=0, keepdim=True)
+                virtual_points[:, 3:] = extra.expand(virtual_xyz.shape[0], -1)
+        return virtual_points
+
+    def _chamfer_l2_loss(self, pred_xyz, target_xyz):
+        if pred_xyz.numel() == 0 or target_xyz.numel() == 0:
+            return pred_xyz.new_tensor(0.0)
+        dist_matrix = torch.cdist(pred_xyz.unsqueeze(0), target_xyz.unsqueeze(0), p=2).squeeze(0)
+        pred_to_target = dist_matrix.min(dim=1).values
+        target_to_pred = dist_matrix.min(dim=0).values
+        return pred_to_target.square().mean() + target_to_pred.square().mean()
+
+    def _apply_object_densifier_augmentation(self, pts_data, teacher_pts_data, gt_bboxes_3d):
+        if not self.use_object_densifier or self.object_densifier is None:
+            return pts_data, None
+
+        max_radar_points = int(self.object_densifier_config.get('max_radar_points', 96))
+        max_lidar_points = int(self.object_densifier_config.get('max_lidar_points', 512))
+        min_radar_points = int(self.object_densifier_config.get('min_radar_points', 1))
+        min_lidar_points = int(self.object_densifier_config.get('min_lidar_points', 8))
+        detach_virtual_points = bool(self.object_densifier_config.get('detach_virtual_points', True))
+        append_virtual_points = bool(self.object_densifier_config.get('append_virtual_points', True))
+        normalize_local_xyz = bool(self.object_densifier_config.get('normalize_local_xyz', True))
+        radar_feature_index = 3 if pts_data and pts_data[0].shape[1] > 3 else None
+        densifier_scale, allow_append = self._get_object_densifier_schedule()
+        append_virtual_points = append_virtual_points and allow_append
+
+        densifier_crops = []
+        densifier_masks = []
+        densifier_centers = []
+        densifier_dims = []
+        densifier_yaws = []
+        densifier_targets = []
+        crop_metadata = []
+        augmented_pts = [sample_pts.clone() for sample_pts in pts_data]
+
+        for batch_idx, (sample_pts, teacher_pts, boxes_3d) in enumerate(zip(pts_data, teacher_pts_data, gt_bboxes_3d)):
+            if teacher_pts is None or boxes_3d.tensor.shape[0] == 0:
+                continue
+
+            boxes_tensor = boxes_3d.tensor[:, :7].to(self.device).contiguous()
+            radar_xyz = sample_pts[:, :3].to(self.device).unsqueeze(0).contiguous()
+            lidar_xyz = teacher_pts[:, :3].to(self.device).unsqueeze(0).contiguous()
+            boxes_batch = boxes_tensor.unsqueeze(0)
+
+            radar_box_indices = points_in_boxes_gpu(radar_xyz, boxes_batch).squeeze(0)
+            lidar_box_indices = points_in_boxes_gpu(lidar_xyz, boxes_batch).squeeze(0)
+
+            sample_pts_device = sample_pts.to(self.device)
+            teacher_pts_device = teacher_pts.to(self.device)
+            for obj_idx in range(boxes_tensor.shape[0]):
+                radar_mask = radar_box_indices == obj_idx
+                lidar_mask = lidar_box_indices == obj_idx
+                radar_crop = sample_pts_device[radar_mask]
+                lidar_crop = teacher_pts_device[lidar_mask][:, :3]
+
+                if radar_crop.shape[0] < min_radar_points or lidar_crop.shape[0] < min_lidar_points:
+                    continue
+
+                radar_crop = self._subsample_points(
+                    radar_crop,
+                    max_points=max_radar_points,
+                    feature_index=radar_feature_index,
+                )
+                lidar_crop = self._subsample_points(
+                    lidar_crop,
+                    max_points=max_lidar_points,
+                    feature_index=None,
+                )
+
+                padded_crop, crop_mask = self._pad_radar_crop(
+                    radar_crop,
+                    max_points=max_radar_points,
+                    feature_dim=sample_pts.shape[1],
+                )
+                densifier_crops.append(padded_crop)
+                densifier_masks.append(crop_mask)
+                densifier_centers.append(boxes_tensor[obj_idx, :3])
+                densifier_dims.append(boxes_tensor[obj_idx, 3:6].clamp_min(1e-2))
+                densifier_yaws.append(boxes_tensor[obj_idx, 6])
+                densifier_targets.append(lidar_crop)
+                crop_metadata.append((batch_idx, radar_crop))
+
+        if not densifier_crops:
+            return pts_data, pts_data[0].new_tensor(0.0)
+
+        densifier_crops = torch.stack(densifier_crops, dim=0)
+        densifier_masks = torch.stack(densifier_masks, dim=0)
+        densifier_centers = torch.stack(densifier_centers, dim=0)
+        densifier_dims = torch.stack(densifier_dims, dim=0)
+        densifier_yaws = torch.stack(densifier_yaws, dim=0)
+
+        for obj_idx in range(densifier_crops.shape[0]):
+            densifier_crops[obj_idx] = self._to_box_local_points(
+                densifier_crops[obj_idx],
+                box_center=densifier_centers[obj_idx],
+                box_dims=densifier_dims[obj_idx],
+                box_yaw=densifier_yaws[obj_idx],
+                normalize=normalize_local_xyz,
+            )
+            densifier_targets[obj_idx] = self._to_box_local_points(
+                densifier_targets[obj_idx],
+                box_center=densifier_centers[obj_idx],
+                box_dims=densifier_dims[obj_idx],
+                box_yaw=densifier_yaws[obj_idx],
+                normalize=normalize_local_xyz,
+            )[:, :3]
+
+        pred_virtual_local_xyz = self.object_densifier(
+            radar_crops=densifier_crops,
+            crop_mask=densifier_masks,
+        )
+
+        aug_loss = pred_virtual_local_xyz.new_tensor(0.0)
+        for obj_idx, target_xyz in enumerate(densifier_targets):
+            aug_loss = aug_loss + self._chamfer_l2_loss(pred_virtual_local_xyz[obj_idx], target_xyz)
+
+            if append_virtual_points:
+                virtual_xyz = self._from_box_local_xyz(
+                    pred_virtual_local_xyz[obj_idx],
+                    box_center=densifier_centers[obj_idx],
+                    box_dims=densifier_dims[obj_idx],
+                    box_yaw=densifier_yaws[obj_idx],
+                    normalize=normalize_local_xyz,
+                )
+                if detach_virtual_points:
+                    virtual_xyz = virtual_xyz.detach()
+                radar_crop = crop_metadata[obj_idx][1]
+                virtual_points = self._build_virtual_point_features(virtual_xyz, radar_crop)
+                sample_idx = crop_metadata[obj_idx][0]
+                augmented_pts[sample_idx] = torch.cat(
+                    [augmented_pts[sample_idx], virtual_points.to(augmented_pts[sample_idx].device)],
+                    dim=0,
+                )
+
+        aug_loss = densifier_scale * aug_loss / max(len(densifier_targets), 1)
+        return augmented_pts, aug_loss
+
+    @property
+    def teacher_model(self):
+        return self.__dict__.get('_teacher_model')
+
+    def _distillation_enabled(self):
+        return bool(self.distillation_config and self.distillation_config.get('enabled', False))
+
+    def _resolve_local_path(self, path_str):
+        path = Path(path_str)
+        if path.is_absolute():
+            return path
+        return Path(os.getcwd()) / path
+
+    def _rewrite_teacher_config_interpolations(self, cfg_node):
+        if isinstance(cfg_node, dict):
+            return {
+                key: self._rewrite_teacher_config_interpolations(value)
+                for key, value in cfg_node.items()
+            }
+
+        if isinstance(cfg_node, list):
+            return [
+                self._rewrite_teacher_config_interpolations(value)
+                for value in cfg_node
+            ]
+
+        if isinstance(cfg_node, str):
+            return cfg_node.replace('${model.', '${')
+
+        return cfg_node
+
+    def _load_teacher_config(self):
+        teacher_config_path = self.distillation_config.get('teacher_config_path', None)
+        if teacher_config_path is None:
+            raise ValueError('distillation.teacher_config_path is required when distillation is enabled.')
+
+        teacher_cfg = OmegaConf.load(self._resolve_local_path(teacher_config_path))
+        teacher_cfg = OmegaConf.to_container(teacher_cfg, resolve=False)
+        teacher_cfg = self._rewrite_teacher_config_interpolations(teacher_cfg)
+        teacher_cfg = OmegaConf.create(teacher_cfg)
+        teacher_cfg['exp_id'] = f"{self.hparams.config.get('exp_id', 'teacher')}_teacher"
+        teacher_cfg['data_root'] = self.data_root
+        teacher_cfg['output_dir'] = self.output_dir
+        OmegaConf.resolve(teacher_cfg)
+        teacher_cfg = OmegaConf.to_container(teacher_cfg, resolve=True)
+        teacher_cfg.pop('distillation', None)
+        return teacher_cfg
+
+    def _build_teacher_model(self):
+        if not self._distillation_enabled():
+            return None
+
+        teacher_checkpoint_path = self.distillation_config.get('teacher_checkpoint_path', None)
+        if not teacher_checkpoint_path:
+            raise ValueError(
+                'distillation.teacher_checkpoint_path is required when distillation is enabled.'
+            )
+
+        teacher_cfg = self._load_teacher_config()
+        teacher_model = CenterPoint(teacher_cfg)
+        checkpoint = torch.load(
+            self._resolve_local_path(teacher_checkpoint_path),
+            map_location='cpu',
+            weights_only=False,
+        )
+        state_dict = checkpoint.get('state_dict', checkpoint)
+        state_dict = self._upgrade_legacy_shared_conv_state_dict(
+            state_dict,
+            teacher_model,
+        )
+        teacher_model.load_state_dict(state_dict, strict=True)
+        teacher_model.eval()
+        for param in teacher_model.parameters():
+            param.requires_grad = False
+
+        return teacher_model.to(self.device)
+
+    @staticmethod
+    def _upgrade_legacy_shared_conv_state_dict(state_dict, model):
+        """Map pre-main shared_conv keys to the new nn.Sequential layout."""
+        target_keys = model.state_dict().keys()
+        expects_sequential = any(
+            key.startswith('head.shared_conv.0.') for key in target_keys
+        )
+        has_legacy_keys = any(
+            key.startswith('head.shared_conv.conv.')
+            or key.startswith('head.shared_conv.BN2d.')
+            for key in state_dict.keys()
+        )
+
+        if not expects_sequential or not has_legacy_keys:
+            return state_dict
+
+        upgraded = {}
+        for key, value in state_dict.items():
+            if key.startswith('head.shared_conv.'):
+                suffix = key[len('head.shared_conv.'):]
+                if not suffix.startswith('0.'):
+                    key = f'head.shared_conv.0.{suffix}'
+            upgraded[key] = value
+        return upgraded
+
+    def _get_teacher_model(self):
+        if self.teacher_model is None:
+            self.__dict__['_teacher_model'] = self._build_teacher_model()
+        return self.teacher_model
+
+    def _build_gt_bev_mask(self, gt_bboxes_3d, spatial_shape, device):
+        height, width = spatial_shape
+        mask = torch.zeros((len(gt_bboxes_3d), 1, height, width), device=device)
+
+        x_min = float(self.pc_range[0].item())
+        y_min = float(self.pc_range[1].item())
+        x_max = float(self.pc_range[3].item())
+        y_max = float(self.pc_range[4].item())
+        x_span = max(x_max - x_min, 1e-6)
+        y_span = max(y_max - y_min, 1e-6)
+
+        for batch_idx, boxes_3d in enumerate(gt_bboxes_3d):
+            bev_boxes = boxes_3d.nearest_bev.to(device)
+            if bev_boxes.numel() == 0:
+                continue
+
+            for bev_box in bev_boxes:
+                x1, y1, x2, y2 = bev_box.tolist()
+                x1_idx = int(np.floor((x1 - x_min) / x_span * width))
+                x2_idx = int(np.ceil((x2 - x_min) / x_span * width))
+                y1_idx = int(np.floor((y1 - y_min) / y_span * height))
+                y2_idx = int(np.ceil((y2 - y_min) / y_span * height))
+
+                x1_idx = min(max(x1_idx, 0), width - 1)
+                y1_idx = min(max(y1_idx, 0), height - 1)
+                x2_idx = min(max(x2_idx, x1_idx + 1), width)
+                y2_idx = min(max(y2_idx, y1_idx + 1), height)
+                mask[batch_idx, 0, y1_idx:y2_idx, x1_idx:x2_idx] = 1.0
+
+        return mask
+
+    def _compute_distillation_loss(self, student_feature, teacher_feature, gt_bboxes_3d):
+        mask_mode = self.distillation_config.get('mask_mode', 'gt_boxes')
+        if mask_mode != 'gt_boxes':
+            raise ValueError(f'Unsupported distillation mask_mode: {mask_mode}')
+
+        if teacher_feature.shape[1] != student_feature.shape[1]:
+            raise ValueError(
+                'Teacher and student feature channels must match for distillation. '
+                f'Got {teacher_feature.shape[1]} and {student_feature.shape[1]}.'
+            )
+
+        if teacher_feature.shape[-2:] != student_feature.shape[-2:]:
+            teacher_feature = F.interpolate(
+                teacher_feature,
+                size=student_feature.shape[-2:],
+                mode='bilinear',
+                align_corners=False,
+            )
+
+        mask = self._build_gt_bev_mask(
+            gt_bboxes_3d=gt_bboxes_3d,
+            spatial_shape=student_feature.shape[-2:],
+            device=student_feature.device,
+        )
+        mask_sum = mask.sum()
+        if mask_sum.item() == 0:
+            return student_feature.new_tensor(0.0)
+
+        loss_type = self.distillation_config.get('loss_type', 'l1')
+        if loss_type == 'l1':
+            per_element_loss = F.l1_loss(student_feature, teacher_feature, reduction='none')
+        elif loss_type == 'smooth_l1':
+            per_element_loss = F.smooth_l1_loss(student_feature, teacher_feature, reduction='none')
+        else:
+            raise ValueError(f'Unsupported distillation loss_type: {loss_type}')
+
+        masked_loss = per_element_loss * mask
+        normalizer = mask_sum * student_feature.shape[1]
+        return masked_loss.sum() / normalizer.clamp_min(1.0)
+
+    def _build_lidar_geometry_targets(self, teacher_pts_data, spatial_shape, device):
+        height, width = spatial_shape
+        occupancy = torch.zeros((len(teacher_pts_data), 1, height, width), device=device)
+        density = torch.zeros((len(teacher_pts_data), 1, height, width), device=device)
+
+        x_min = float(self.pc_range[0].item())
+        y_min = float(self.pc_range[1].item())
+        x_max = float(self.pc_range[3].item())
+        y_max = float(self.pc_range[4].item())
+        x_span = max(x_max - x_min, 1e-6)
