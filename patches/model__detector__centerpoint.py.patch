+        fused_features, gate = self.point_fusion(
+            radar_pillar_features,
+            image_pillar_features,
+            context_features=pillar_context,
+        )
+        gate_strength = gate.mean(dim=1)
+        self.latest_pillar_gate_strengths = gate_strength
+        return fused_features
