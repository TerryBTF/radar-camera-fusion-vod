+    def _build_image_bev_guidance(self, image_pillar_features, coors, batch_size):
+        if not self.use_bev_fusion or image_pillar_features is None or image_pillar_features.shape[0] == 0:
+            return None
+        projected_image = self.image_bev_projector(image_pillar_features)
+        image_bev = self.middle_encoder(projected_image, coors, batch_size)
+        return self.image_bev_adapter(image_bev)
