+    def _reset_gate_stats(self):
+        self.gate_stats = {
+            'global_sum': 0.0,
+            'global_sq_sum': 0.0,
+            'global_count': 0,
+            'global_low_count': 0,
+            'global_high_count': 0,
+            'class_sum': {name: 0.0 for name in self.class_names or []},
+            'class_count': {name: 0 for name in self.class_names or []},
+            'distance_sum': {'near': 0.0, 'mid': 0.0, 'far': 0.0},
+            'distance_count': {'near': 0, 'mid': 0, 'far': 0},
+        }
