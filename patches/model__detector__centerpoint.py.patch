+    def _build_pillar_fusion_context(self, coors, num_points):
+        if coors is None or num_points is None:
+            return None
+
+        vx = float(self.voxel_layer.voxel_size[0])
+        vy = float(self.voxel_layer.voxel_size[1])
+        x_min = float(self.voxel_layer.point_cloud_range[0])
+        y_min = float(self.voxel_layer.point_cloud_range[1])
+        x_max = float(self.voxel_layer.point_cloud_range[3])
+        y_max = float(self.voxel_layer.point_cloud_range[4])
+
+        centers_x = coors[:, 3].float() * vx + x_min + vx / 2
+        centers_y = coors[:, 2].float() * vy + y_min + vy / 2
+        distance = torch.sqrt(centers_x.square() + centers_y.square())
+        max_distance = float((x_max ** 2 + max(abs(y_min), abs(y_max)) ** 2) ** 0.5)
+        distance = distance / max(max_distance, 1e-6)
+
+        max_points = max(float(self.voxel_layer.max_num_points), 1.0)
+        density = num_points.float() / max_points
+        return torch.stack([distance, density], dim=-1)
+
